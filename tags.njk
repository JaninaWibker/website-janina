---
pagination:
  data: collections
  size: 1
  alias: tag
  filter:
    - all
    - nav
    - post
    - posts
    - tagList
  addAllPagesToCollections: true
layout: layouts/home.njk
eleventyComputed:
  title: Tagged “{{ tag }}”
  header_title: janina's blog
permalink: /tags/{{ tag | slug }}/
---
{%- from "components/underline.njk" import underline -%}
<h1>“{{ tag }}”</h1>
{{ underline() }}

{% set postslist = collections[ tag ] %}
{% include "bloglist.njk" %}
