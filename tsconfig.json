{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "downlevelIteration": true,
    "allowSyntheticDefaultImports": true,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "plugins": [{ "name": "next" }],

    "declarationDir": "dist",
    "outDir": "dist",
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    // code
    "**/*.ts",
    "**/*.tsx",

    // config files
    "eslint.config.ts",
    "postcss.config.js",

    // nextjs
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "next.config.*"
  ],
  "exclude": ["node_modules"]
}
